/** Earth Atmosphere Scattering & Transmittance 
*   Shared Shader Functions Unit.
* - ref: <https://zhuanlan.zhihu.com/p/595576594>
*/

/// Planet's radius in World-Space coord.
#![const<float>("ATMOS_PLANET_RADIUS")]

/// Atmosphere's radius in World-Space coord.
/// (aka. Planet radius + Atmosphere thickness)
#![const<float>("ATMOS_ATMOS_RADIUS")]

/// Sample times of transmittance calculation.
#![const<int>("ATMOS_TRANSMITTANCE_SAMPLE_NUM")]

/// Control the atmosphere's visual thickness, for artistic purpose.
/// `factor = 1.0` is default (physically correct).
/// `factor > 1.0` to get thicker atmosphere.
/// Basically it's upraising lower atmosphere to higher altitude.
#![const<float>("ATMOS_ARTISTIC_FACTOR")]


#![use("consts.su")]

const float EarthRadius = 6371000.0;
const float ATMOS_UNIT  = EarthRadius / (ATMOS_PLANET_RADIUS * ATMOS_ARTISTIC_FACTOR);

const float RayleighScatteringScalarHeight = 8500.0;
const float MieScatteringScalarHeight = 1200.0;
const float MieAnisotropy = 0.8;
const float OzoneLevelCenterHeight = 25000.0;
const float OzoneLevelWidth = 15000.0;

vec3 RayleighCoefficient(float h) {
    const vec3 sigma = vec3(5.802, 13.558, 33.1) * 1e-6 * ATMOS_UNIT;
    float SH   = RayleighScatteringScalarHeight;
    float rhoH = exp(-(ATMOS_UNIT * h / SH));
    return sigma * rhoH;
}

float RayleighPhase(float cosTheta) {
    return (3.0 / (16.0 * PI)) * (1.0 + cosTheta * cosTheta);
}

vec3 MieCoefficient(float h) {
    const vec3 sigma = vec3(3.996) * 1e-6 * ATMOS_UNIT;
    float SH   = MieScatteringScalarHeight;
    float rhoH = exp(-(ATMOS_UNIT * h / SH));
    return sigma * rhoH;
}

float MiePhase(float cosTheta) {
    float g = MieAnisotropy;
    float g2 = g * g;
    float a = 3.0 / (8.0 * PI);
    float b = (1.0 - g2) / (2.0 + g2);
    float c = 1.0 + cosTheta * cosTheta;
    float d = pow(1.0 + g2 - 2.0 * g * cosTheta, 1.5);

    return a * b * (c / d);
}

vec3 MieAbsorption(float h) {
    const vec3 sigma = vec3(4.4) * 1e-6 * ATMOS_UNIT;
    float SH   = MieScatteringScalarHeight;
    float rhoH = exp(-(ATMOS_UNIT * h / SH));
    return sigma * rhoH;
}

vec3 OzoneAbsorption(float h, float center, float width) {
    const vec3 sigma = vec3(0.68, 1.881, 0.085) * 1e-6 * ATMOS_UNIT;
    float rho = max(0.0, 1.0 - abs(ATMOS_UNIT * h - center) / width);
    return sigma * rho;
}

/// Scattering at point `p`.
/// - `center`: planet's center
/// - `inDir`: light incident direction
/// - `outDir`: light emergent direction
vec3 Scattering(vec3 center, vec3 p, vec3 inDir, vec3 outDir) {
    float cosTheta = dot(inDir, outDir);
    float h = distance(p, center) - ATMOS_PLANET_RADIUS;
    vec3 rayleigh = RayleighCoefficient(h) * RayleighPhase(cosTheta);
    vec3 mie = MieCoefficient(h) * MiePhase(cosTheta);
    return rayleigh + mie;
}

/// Transmittance from `p1` -> `p2`.
/// - `center`: planet's center
vec3 Transmittance(vec3 center, vec3 p1, vec3 p2) {    
    vec3  dir = normalize(p2 - p1);
    float dis = distance(p2, p1);
    float ds  = dis / float(ATMOS_TRANSMITTANCE_SAMPLE_NUM);

    vec3 sum = vec3(0.0);
    vec3 p   = p1 + (dir * ds) * 0.2;

    for (int i = 0; i < ATMOS_TRANSMITTANCE_SAMPLE_NUM; ++i) {
        float h = distance(p, center) - ATMOS_PLANET_RADIUS;

        vec3 scattering = RayleighCoefficient(h) + MieCoefficient(h);
        vec3 absorption = OzoneAbsorption(h, OzoneLevelCenterHeight, OzoneLevelWidth) + MieAbsorption(h);
        vec3 extinction = scattering + absorption;

        sum += extinction * ds;
        p   += dir * ds;
    }

    return exp(-sum);
}

/// LUT's UV to Transmittance params.
/// - @return: vec3( mu, d, r )
vec3 UVToTransmittanceParams(vec2 uv) {
    const float innerR = ATMOS_PLANET_RADIUS;
    const float outerR = ATMOS_ATMOS_RADIUS;

    float x_mu = uv.x;
    float x_r = uv.y;

    float H = sqrt(max(0.0f, outerR * outerR - innerR * innerR));
    float rho = H * x_r;
    
    float r = sqrt(max(0.0f, rho * rho + innerR * innerR));

    float d_min = outerR - r;
    float d_max = rho + H;
    float d = d_min + x_mu * (d_max - d_min);
    
    float mu = d == 0.0f ? 1.0f : (H * H - rho * rho - d * d) / (2.0f * r * d);
    mu = clamp(mu, -1.0f, 1.0f);

    return vec3(mu, d, r);
}

/// Transmittance params to LUT's UV.
/// - @return: vec2( u, v )
vec2 TransmittanceParamsToUV(float mu, float r) {
    const float innerR = ATMOS_PLANET_RADIUS;
    const float outerR = ATMOS_ATMOS_RADIUS;

    float H = sqrt(max(0.0f, outerR * outerR - innerR * innerR));
    float rho = sqrt(max(0.0f, r * r - innerR * innerR));

    float discriminant = r * r * (mu * mu - 1.0f) + outerR * outerR;
	float d = max(0.0f, (-r * mu + sqrt(discriminant)));

    float d_min = outerR - r;
    float d_max = rho + H;

    float x_mu = (d - d_min) / (d_max - d_min);
    float x_r = rho / H;

    return vec2(x_mu, x_r);
}